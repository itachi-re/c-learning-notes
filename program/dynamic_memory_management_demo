                            if (value != -1)
                                printf("Popped: %d\n", value);
                            break;
                        case 3:
                            printf("Enter index: ");
                            scanf("%d", &index);
                            printf("Enter value: ");
                            scanf("%d", &value);
                            insert(arr, index, value);
                            break;
